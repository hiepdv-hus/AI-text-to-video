    "typecheck": "tsc --noEmit",
    "test": "tsx --test pipeline/*.test.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.515",
    "@remotion/captions": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/fonts": "4.0.515",
    "@remotion/google-fonts": "4.0.515",
    "@remotion/install-whisper-cpp": "4.0.515",
    "@remotion/media-utils": "4.0.515",
    "@remotion/paths": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "@remotion/transitions": "4.0.515",
    "@remotion/zod-types": "4.0.515",
    "lucide-react": "^1.40.0",
    "msedge-tts": "^2.0.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.515",
    "shiki": "^4.4.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "packageManager": "pnpm@11.23.0"
}
