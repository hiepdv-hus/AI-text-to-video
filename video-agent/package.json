{
  "name": "video-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống tạo video ngắn tự động (1080x1920) điều khiển bằng tiếng Việt qua AI agent. Agent sinh VideoSpec JSON, pipeline deterministic render ra MP4.",
  "type": "module",
  "scripts": {
    "video": "tsx cli.ts",
