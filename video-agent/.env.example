# Sao chép file này thành .env và điền key thật khi muốn dùng giọng đọc cao cấp.
#
# KHÔNG cần key nếu dùng:
#   - provider "edge"  → giọng vi-VN thật, MIỄN PHÍ (chỉ cần mạng). KHUYẾN NGHỊ.
#   - provider "piper" → giọng vi local, MIỄN PHÍ, offline (cài scripts/setup-piper.ps1).
#   - provider "mock"  → giọng im lặng, chạy offline, chỉ để test timing/caption.
# Các key dưới đây chỉ cần khi muốn ElevenLabs / Azure / Google.

# --- Ảnh thật từ Pexels (media.kind "pexels") ---
# Đăng ký MIỄN PHÍ ở https://www.pexels.com/api/ → lấy API key (200 lượt/giờ).
PEXELS_API_KEY=

# --- Tự sinh ảnh minh họa bằng AI (media.kind "generate") ---
# Mặc định dùng Pollinations.ai: MIỄN PHÍ, KHÔNG cần key. Không cần đặt gì.
# Muốn chất lượng cao hơn bằng DALL·E: đặt IMAGE_PROVIDER=openai + OPENAI_API_KEY.
IMAGE_PROVIDER=pollinations
OPENAI_API_KEY=

# --- ElevenLabs (có timestamp cấp ký tự, khỏi cần Whisper) ---
ELEVENLABS_API_KEY=
# Model mặc định hỗ trợ tiếng Việt tốt:
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Azure Speech (ưu tiên 2: giọng vi-VN tốt) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# --- Google Cloud TTS (ưu tiên 3: không có word timestamp → cần align Whisper) ---
GOOGLE_TTS_API_KEY=

# --- Align bằng Whisper (chỉ cần khi provider KHÔNG tự trả timing, vd Azure/Google) ---
# Bật để lấy word-timing local, miễn phí (tự tải & build whisper.cpp lần đầu, khá nặng).
ALIGN_WITH_WHISPER=0
# Model cho tiếng Việt: medium (nhẹ) hoặc large-v3 (chuẩn hơn).
WHISPER_MODEL=medium

# --- ffmpeg/ffprobe (cần cho provider trả MP3 như Edge để lấy độ dài audio) ---
# Thư mục chứa ffprobe.exe (bỏ trống nếu ffmpeg đã có trên PATH).
# Vd (winget): C:/Users/<ban>/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_.../ffmpeg-*/bin
FFMPEG_BIN=
